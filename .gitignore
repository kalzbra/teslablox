# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw source photos — LOCAL ONLY, never committed. Several originals carry embedded GPS/EXIF
# data; the whole point of the image pipeline (scripts/process-images.mjs) is to strip that
# before anything public exists. What actually ships is the stripped output in public/photos
# and public/trip below, which IS committed. See README.md "How photos work".
/photos/
/teslas-trip/

# private, non-public data (exact DOB etc.) and working notes — never ship or publish these
/private/
/internal-notes/

